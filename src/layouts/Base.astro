---
import '../styles/site.css'
import { site } from '../config'

interface Props {
  title?: string
  description?: string
  active?: 'posts' | 'archive' | 'about'
  type?: 'website' | 'article'
}
const { title, description = site.description, active, type = 'website' } = Astro.props
const pageTitle = title ? `${title} — ${site.title}` : `${site.title} — Sihyeok Park`
const canonical = new URL(Astro.url.pathname, Astro.site)
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon/favicon-light-32.png" sizes="32x32" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon/favicon-dark-32.png" sizes="32x32" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/favicon/favicon-light-192.png" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <!-- Theme before first paint (same key as exon.kr) -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme')
          if (t !== 'dark' && t !== 'light') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
          document.documentElement.dataset.theme = t
          if (t === 'dark') document.querySelector('meta[name="theme-color"]').setAttribute('content', '#0e0e11')
        } catch (e) {}
      })()
    </script>
    <link rel="stylesheet" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <nav class="topnav">
      <div class="nav-inner">
        <a class="nav-name" href="/">EXON <span>Blog</span></a>
        <div class="nav-links">
          <a href="/" class:list={[{ active: active === 'posts' }]}>Posts</a>
          <a href="/archive/" class:list={[{ active: active === 'archive' }]}>Archive</a>
          <a href="/about/" class:list={[{ active: active === 'about' }]}>About</a>
          <a href={site.home}>exon.kr ↗</a>
        </div>
        <button class="icon-btn" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
          <svg class="i-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z"></path></svg>
          <svg class="i-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        </button>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="sitefoot">
      © {new Date().getFullYear()} <a href={site.home}>Sihyeok Park</a> · <a href={site.github}>GitHub</a> · <a href="/rss.xml">RSS</a>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', function () {
        var t = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
        document.documentElement.dataset.theme = t
        document.querySelector('meta[name="theme-color"]').setAttribute('content', t === 'dark' ? '#0e0e11' : '#ffffff')
        try { localStorage.setItem('theme', t) } catch (e) {}
      })
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
        var stored = null
        try { stored = localStorage.getItem('theme') } catch (err) {}
        if (!stored) document.documentElement.dataset.theme = e.matches ? 'dark' : 'light'
      })
    </script>
  </body>
</html>
