---
import PostList from '../../../components/PostList.astro'
import Base from '../../../layouts/Base.astro'
import { getPosts } from '../../../utils/posts'

export async function getStaticPaths() {
  const posts = await getPosts()
  const cats = [...new Set(posts.map((p) => p.data.category).filter(Boolean))] as string[]
  return cats.map((category) => ({ params: { category }, props: { category } }))
}
const { category } = Astro.props
const posts = (await getPosts()).filter((p) => p.data.category === category)
---
<Base title={category} active="archive">
  <header class="page-head">
    <div class="crumb"><a href="/archive/">Archive</a> / Category</div>
    <h1>{category}</h1>
    <p>{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
  </header>
  <section>
    <PostList posts={posts} />
  </section>
</Base>
