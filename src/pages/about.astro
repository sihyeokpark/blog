---
import { site } from '../config'
import Base from '../layouts/Base.astro'
---
<Base title="About" active="about">
  <header class="page-head">
    <h1>About</h1>
    <p>I'm <b>Sihyeok Park</b>, a.k.a. <b>EXON</b> — an undergraduate in Electrical &amp; Computer Engineering at Seoul National University. I like web security, CTFs, and building small tools people actually use.</p>
    <div class="toc-chips">
      <a class="chip" href={site.home}>Portfolio · exon.kr</a>
      <a class="chip" href={site.github}>GitHub</a>
      <a class="chip" href={`mailto:${site.email}`}>Email</a>
    </div>
  </header>
  <section>
    <h2 class="sec">Colleagues</h2>
    <div class="about-row"><span class="lead">z1gyeol</span><a href="https://z1gyeol.github.io">z1gyeol.github.io</a></div>
    <div class="about-row"><span class="lead">c0degolf</span><a href="https://c0degolf.github.io">c0degolf.github.io</a></div>
    <div class="about-row"><span class="lead">Wane</span><a href="https://blog.wane.im">blog.wane.im</a></div>
  </section>
</Base>
